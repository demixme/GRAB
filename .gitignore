# Build output
/build/
/out/
/cmake-build-*/

# JUCE / CMake FetchContent cache (JUCE is fetched, never committed)
/_deps/
*.user

# Reference repos kept locally but NOT tracked (vendored copy of
# roli_blocks_basics IS tracked; these two stay out of our history).
/third_party/blocksd/
/third_party/myblocks/

# Editor / OS
.vs/
.vscode/
*.swp
.DS_Store

# Device logs produced by seaprobe (Phase 2)
/logs/
*.sysex.log

# Wireshark/USBPcap captures (local only)
/captures/
*.pcapng

# Contributed device profiles (local; submit via tool or GitHub)
/profiles/

# Python bytecode (from mitmproxy running tools/*.py)
__pycache__/
*.pyc

# Server DB credentials (copy config.sample.php -> config.php)
/server/config.php

# Maintainer-only export token (never commit)
/.grab-export-token
*.token
